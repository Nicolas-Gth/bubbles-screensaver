msgid "Bubbles"
msgstr "Burbujas"

msgid "Style"
msgstr "Estilo"

msgid "Iridescent"
msgstr "Iridiscente"

msgid "Multicolor"
msgstr "Multicolor"

msgid "Transparent"
msgstr "Transparente"

msgid "Custom color"
msgstr "Color personalizado"

msgid "Number of bubbles"
msgstr "Número de burbujas"

msgid "Target number of bubbles on screen"
msgstr "Número objetivo de burbujas en pantalla"

msgid "Bubble layers"
msgstr "Capas de burbujas"

msgid "Number of depth layers (the bubble count is divided between them)"
msgstr "Número de capas de profundidad (el número de burbujas se reparte entre ellas)"

msgid "Average size"
msgstr "Tamaño medio"

msgid "Average radius, as % of the smallest screen side"
msgstr "Radio medio, en % del lado más pequeño de la pantalla"

msgid "Size variation"
msgstr "Variación de tamaño"

msgid "Random variation around the average size, in %"
msgstr "Variación aleatoria alrededor del tamaño medio, en %"

msgid "Speed"
msgstr "Velocidad"

msgid "Cruising speed, as % of the smallest side per second"
msgstr "Velocidad de crucero, en % del lado más pequeño por segundo"

msgid "Spawn interval"
msgstr "Intervalo de aparición"

msgid "Average delay between two bubbles (smaller = more bubbles arriving)"
msgstr "Retardo medio entre dos burbujas (más pequeño = más burbujas apareciendo)"

msgid "Timing"
msgstr "Tiempo"

msgid "Activate after idle"
msgstr "Activar tras inactividad"

msgid "Delay before the screensaver starts, in minutes"
msgstr "Retardo antes de que se inicie el salvapantallas, en minutos"

msgid "Fade to black after"
msgstr "Fundido a negro tras"

msgid "Length of the transparent phase before the fade, in seconds"
msgstr "Duración de la fase transparente antes del fundido, en segundos"

msgid "Miscellaneous"
msgstr "Varios"

msgid "Explode on exit"
msgstr "Explosionar al salir"

msgid "Burst bubbles into a droplet cloud when exiting the screensaver"
msgstr "Hacer estallar las burbujas en una nube de gotas al salir del salvapantallas"

msgid "Launch the screensaver now"
msgstr "Iniciar el salvapantallas ahora"

msgid "Reset to defaults"
msgstr "Restablecer valores predeterminados"

msgid "Reset"
msgstr "Restablecer"

msgid "Reset settings?"
msgstr "¿Restablecer la configuración?"

msgid "All settings will be restored to their default values."
msgstr "Todos los ajustes se restablecerán a sus valores predeterminados."

msgid "Cancel"
msgstr "Cancelar"

msgid "About"
msgstr "Acerca de"

msgid "A GNOME screensaver that draws bubbles in the shell after idle."
msgstr "Un salvapantallas de GNOME que dibuja burbujas en el shell tras un periodo de inactividad."

msgid "Author: Nicolas-Gth"
msgstr "Autor: Nicolas-Gth"
